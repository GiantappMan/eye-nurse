{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EyeNurse",
  "mainBinaryName": "eyenurse",
  "version": "3.0.0",
  "identifier": "cn.giantapp.eyenurse3",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "url": "index.html",
        "title": "EyeNurse",
        "width": 900,
        "height": 500,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "skincenter",
        "url": "skincenter.html",
        "title": "EyeNurse",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://eyenurse-skin.localhost; frame-src http://eyenurse-skin.localhost"
    }
  },
  "bundle": { "active": false }
}
